# Copy to .env (gitignored) and fill in. Read by app/generate-project.sh and the ops/ scripts
# (ops/deploy.sh copies .env to the server along with the code). Every value is optional.

# --- Apps (app/generate-project.sh bakes it into the Xcode project) ---
# The server the apps sync with by default (Settings can override), e.g. http://my-server:8451
STACKS_SERVER_URL=

# --- Deploy (ops/deploy.sh, run on your Mac) ---
# The ssh host the server runs on.
STACKS_DEPLOY_HOST=

# --- Server ---
# ops/run.sh: the server's time zone (it sets TZ from this; default UTC), e.g. America/New_York.
# It decides which day a reading session or a progress update counts for.
STACKS_TZ=
# Where the SQLite database lives (default ~/Library/Application Support/stacks/stacks.db).
STACKS_DB=
# For `pnpm serve` only (ops/run.sh always uses 8782 and ~/Stacks):
# PORT=8782
# STACKS_HOME=~/Stacks          # book files, covers and the Inbox folder

# --- Grimoire (only `pnpm import-catalog`, the old launch-day scripts and their tests use it) ---
# The Grimoire graph directory (default ~/Grimoire).
GRIMOIRE_GRAPH=
# Path to the grim CLI (default ~/.local/bin/grim).
GRIM_BIN=

# --- Backup (ops/backup.sh, nightly on the server) ---
# Where the nightly backup goes (default ~/StacksBackup), e.g. a synced, off-site folder.
STACKS_BACKUP_DIR=
