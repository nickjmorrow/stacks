# Copy to .env (gitignored) and fill in. Read by app/generate-project.sh and the ops/ scripts
# (ops/deploy.sh copies .env to the server along with the code).
# The server the apps sync with by default (Settings can override), e.g. http://<host>:8451
STACKS_SERVER_URL=
# ops/deploy.sh: the ssh host the server runs on.
STACKS_DEPLOY_HOST=
# ops/run.sh: the server's time zone for daily progress notes (default UTC), e.g. America/New_York
STACKS_TZ=
# ops/run.sh: the Grimoire graph (only `pnpm import-catalog` reads it; default ~/Grimoire)
GRIMOIRE_GRAPH=
# ops/backup.sh: where the nightly backup goes (default ~/StacksBackup)
STACKS_BACKUP_DIR=
